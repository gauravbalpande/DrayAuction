# ─────────────────────────────────────────────────────────────────────────────
# Secrets — Template (DO NOT commit real values)
# Apply these manually:
#   kubectl apply -f secrets.yaml -n auctionxi
#
# All values must be base64-encoded:
#   echo -n "mypassword" | base64
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: auctionxi
  labels:
    app: postgres
type: Opaque
data:
  # echo -n "auctionxi" | base64
  POSTGRES_USER: REPLACE_WITH_BASE64_USER
  # echo -n "your-secure-password" | base64
  POSTGRES_PASSWORD: REPLACE_WITH_BASE64_PASSWORD

---

apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: auctionxi
  labels:
    app: backend
type: Opaque
data:
  # postgres://auctionxi:<password>@postgres:5432/auctionxi?sslmode=disable
  DATABASE_URL: REPLACE_WITH_BASE64_DB_URL
  # redis://redis:6379/0
  REDIS_URL: cmVkaXM6Ly9yZWRpczozNjc5LzA=
  # Your JWT secrets (generate with: openssl rand -hex 64)
  JWT_ACCESS_SECRET: REPLACE_WITH_BASE64_JWT_ACCESS
  JWT_REFRESH_SECRET: REPLACE_WITH_BASE64_JWT_REFRESH
